{
  "name": "frites.dev",
  "version": "1.0.16",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "patch": "npm version patch --no-git-tag-version",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node ./scripts/fix-unenv.cjs",
    "prepare": "husky",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "upgrade": "nuxi upgrade",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "firebase deploy"
  },
  "lint-staged": {
    "*.{ts,js,vue,css,json,yaml}": [
      "npx prettier --list-different",
      "npx eslint"
    ]
  },
  "devDependencies": {
    "@iconify-json/flag": "^1.2.10",
    "@iconify-json/iconoir": "^1.2.10",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.68",
    "@iconify-json/tabler": "^1.2.26",
    "@iconify-json/tdesign": "^1.2.12",
    "@iconify-json/vscode-icons": "^1.2.40",
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "^1.13.0",
    "@nuxt/fonts": "^0.13.0",
    "@nuxt/scripts": "^0.13.2",
    "@nuxt/ui": "^2.22.3",
    "@nuxtjs/seo": "^3.3.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@vue/test-utils": "^2.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nuxt": "^3.21.0",
    "nuxt-security": "^2.5.1",
    "playwright-core": "^1.58.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vite-plugin-eslint2": "^5.0.4",
    "vitest": "^3.2.4",
    "vue": "latest",
    "vue-tsc": "^3.2.4"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@nuxt/test-utils": "^3.23.0",
    "@vueuse/components": "^14.1.0",
    "@vueuse/core": "^14.1.0",
    "zod": "^3.25.76"
  }
}
